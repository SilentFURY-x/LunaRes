# ---- Database ----
POSTGRES_USER=lunares
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lunares
DATABASE_URL=postgresql://lunares:changeme@localhost:5432/lunares

# ---- Redis / Job Queue ----
REDIS_URL=redis://localhost:6379/0

# ---- Object Storage (MinIO locally, S3 in prod) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lunares-scenes
S3_REGION=us-east-1

# ---- ISRO Pipeline Adapter ----
# Set ADAPTER_MODE=mock until Bhoonidhi API access is granted
BHOONIDHI_ADAPTER_MODE=mock
BHOONIDHI_API_BASE_URL=https://bhoonidhi.nrsc.gov.in/api
BHOONIDHI_API_KEY=

# ---- Auth ----
JWT_SECRET=changeme-generate-a-real-secret
API_KEY_SALT=changeme

# ---- Model ----
SR_MODEL_WEIGHTS_PATH=/models/sr_fast_v1.pt
UNCERTAINTY_MODEL_WEIGHTS_PATH=/models/uncertainty_v1.pt
MODEL_VERSION=lunares-sr-v0.1.0

# ---- Tile Server ----
TITILER_URL=http://localhost:8001

# ---- Processing ----
TILE_SIZE=512
TILE_OVERLAP=64
SR_SCALE_FACTOR=4
MAX_UPLOAD_SIZE_MB=500

# ---- CORS ----
CORS_ORIGINS=["*"]

# ---- Presigned URLs ----
PRESIGNED_URL_EXPIRY_SECONDS=3600

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
VITE_TILE_SERVER_URL=http://localhost:8001
